    grant_nbr as GrantNbr,
    cs_trans_t as CsTransT,
    measure as Measure,
    segment as Segment,
    partner_segment as PartnerSegment,
    res_doc as ResDoc,
    res_item as ResItem,
    billing_period_start_date as BillingPeriodStartDate,
    billing_period_end_date as BillingPeriodEndDate,
    ppa_ex_ind as PpaExInd,
    fastpay as Fastpay,
    partner_grant_nbr as PartnerGrantNbr,
