unmanaged implementation in class /zuora001/bp_r_je_h unique;
strict ( 1 );

define behavior for /ZUORA001/R_JE_H //alias <alias_name>
//late numbering
lock master
authorization master ( instance )
//etag master <field_name>
{
  create;
  update;
  delete;
  field ( readonly ) je_uid, customer_id, JeDocNumber;
  association CURRENCYAMOUNT { create; }
  association ACCOUNTGL { create; }
  association ACCOUNTRECEIVABLE { create; }
  association ACCOUNTPAYABLE { create; }
  association RETURN { create; }
  association EXTENSION1 { create; }
  association EXTENSION2 { create; }
  association ACCOUNTTAX { create; }
  mapping for /zuora001/t_je_h
    {

      // Table Fields
      je_uid             = je_uid; // UUID for the journal entry
      customer_id        = customer_id; // Customer ID
      destination_system = destination_system; // Destination System Name
      destination_name   = destination_name; // Destination Name
      LandScape          = land_scape; // landscape
      JeDocNumber        = je_doc_number; // Journal Entry Document Number
      ObjType            = obj_type; // Object Type
      ObjKey             = obj_key; // Object Key
      ObjSys             = obj_sys; // Object System
      BusAct             = bus_act; // Business Activity
      Username           = username; // Username in Journal Entry
      HeaderTxt          = header_txt; // Header Text
      CompCode           = comp_code; // Company Code
      DocDate            = doc_date; // Document Date
      PstngDate          = pstng_date; // Posting Date
      TransDate          = trans_date; // Transaction Date
      FiscYear           = fisc_year; // Fiscal Year
      FisPeriod          = fis_period; // Fiscal Period
      DocType            = doc_type; // Document Type
      RefDocNo           = ref_doc_no; // Reference Document Number
      AcDocNo            = ac_doc_no; // Accounting Document Number
      ObjKeyR            = obj_key_r; // Reverse Object Key
      ReasonRev          = reason_rev; // Reason for Reversal
      CompoAcc           = compo_acc; // Component Account
      RefDocNoLong       = ref_doc_no_long; // Long Reference Document Number
      AccPrinciple       = acc_principle; // Accounting Principle
      NegPostng          = neg_postng; // Negative Posting Indicator
      ObjKeyInv          = obj_key_inv; // Invoice Object Key
      BillCategory       = bill_category; // Billing Category
      Vatdate            = vatdate; // VAT Date
      InvoiceRecDate     = invoice_rec_date; // Invoice Received Date
      EcsEnv             = ecs_env; // ECS Environment
      PartialRev         = partial_rev; // Partial Reversal
      DocStatus          = doc_status; // Document Status
      ExchangRate        = exchange_rate;
    }
}

