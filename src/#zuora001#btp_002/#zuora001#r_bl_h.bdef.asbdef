unmanaged implementation in class /zuora001/bp_r_bl_h unique ;
strict ( 2 );

define behavior for /ZUORA001/R_BL_H //alias <alias_name>
//late numbering
lock master
authorization master ( instance )
//etag master <field_name>
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly ) je_uid, customer_id;
  association CONDITIONDATAIN { create; }
  association ERRORS { create; }
  association BILLINGDATAIN { create;}
  association RETURN { create; }
  association NFMETALLITMS { create; }
  association SUCCESS { create; }
  association TEXTDATAIN { create; }
  association CCARDDATAIN { create; }
 mapping for /zuora001/t_bl_h
{
  // Table Fields
  je_uid              = je_uid;               // Unique ID for Billing Header
  customer_id         = customer_id;          // Customer ID
  bl_doc_number       = bl_doc_number;        // Billing Document Number
  destination_system  = destination_system;   // Destination System
  destination_name    = destination_name;     // Destination Name
  land_scape          = land_scape;           // Landscape (DEV/QAS/PRD)
  created_by          = created_by;           // Created By
  created_on          = created_on;           // Created On (Date/Time)
  testrun             = testrun;              // Test Run Flag
  posting_type        = posting_type;         // Posting Type (F2, etc.)
  Username  = Username;
  lastchangedat       = lastchangedat;        // UTC Last Changed DateTime
  locallastchangedat  = locallastchangedat;   // Local Last Changed DateTime
}

}

